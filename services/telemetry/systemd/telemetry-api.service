[Unit]
Description=Deji Cloud // ElysiaJS OS Telemetry API Daemon
After=network.target

[Service]
Type=simple
User=deji
WorkingDirectory=/opt/portfolio-telemetry/services/telemetry
ExecStart=/home/deji/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=0.0.0.0
SyslogIdentifier=telemetry-api

# Security & Sandboxing directives
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
